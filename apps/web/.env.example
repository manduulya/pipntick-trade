NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

NEXT_PUBLIC_API_URL=http://localhost:3001

# Public origin of the deployed site — used for metadataBase, canonical URLs, robots.txt, and
# sitemap.xml. Defaults to https://pipntick.trade when unset.
NEXT_PUBLIC_SITE_URL=https://pipntick.trade

# Google AdSense — see apps/web/src/app/dashboard/AdSlot.tsx. Client ID is your account-wide
# ca-pub-XXXXXXXXXXXXXXXX publisher ID; slot ID is per ad-unit, created in the AdSense dashboard.
# CLIENT_ID must be set in the deploy environment for the loader script to render at all.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your_publisher_id
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT_ID=your_ad_slot_id
